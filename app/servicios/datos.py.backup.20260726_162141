def get_acidificacion_ultimos(limite=100):
    """Obtener datos de acidificación"""
    sql = """
        SELECT fecha, lat, lon, ph, aragonito, ph_anomalia, profundidad
        FROM hdo.acidificacion
        ORDER BY fecha DESC
        LIMIT %s
    """
