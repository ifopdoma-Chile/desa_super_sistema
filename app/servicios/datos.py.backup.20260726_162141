"""
Servicio de consultas a base de datos HDO
"""
import pandas as pd
from datetime import datetime, timedelta
from app.servicios.db import query, get_db
import logging

logger = logging.getLogger(__name__)

def get_enos_ultimos(limite=60):
    """Obtener últimos registros ENOS"""
    sql = """
        SELECT fecha, oni, nino34, soi, hci, mei, nino12_hdo
        FROM hdo.enos_indicadores
        ORDER BY fecha DESC
        LIMIT %s
    """
    return query(sql, (limite,))

def get_enos_historico(desde=None, hasta=None):
    """Obtener serie histórica ENOS"""
    sql = """
        SELECT fecha, oni, nino34, soi, hci, mei, nino12_hdo
        FROM hdo.enos_indicadores
        WHERE 1=1
    """
    params = []
    if desde:
        sql += " AND fecha >= %s"
        params.append(desde)
    if hasta:
        sql += " AND fecha <= %s"
        params.append(hasta)
    sql += " ORDER BY fecha ASC"
    return query(sql, params)

def get_surgencia_ultimos(limite=100):
    """Obtener últimos registros de surgencia"""
    sql = """
        SELECT fecha, latitud, zona, ekman_transport, cui, sst_costera, anomalia_surgencia
        FROM hdo.surgencia
        ORDER BY fecha DESC
        LIMIT %s
    """
    return query(sql, (limite,))

def get_surgencia_por_zona(zona, limite=365):
    """Obtener surgencia por zona"""
    sql = """
        SELECT fecha, latitud, ekman_transport, cui, sst_costera
        FROM hdo.surgencia
        WHERE zona = %s
